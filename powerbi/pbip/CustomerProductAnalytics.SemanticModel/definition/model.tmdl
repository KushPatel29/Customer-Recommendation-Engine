model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["fact_sales", "dim_customer", "dim_product", "cross_sell", "fact_forecast", "dim_month", "_Measures", "cohort_retention", "holdout_evaluation", "forecast_backtest", "sku_affinity", "DataPath"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table fact_sales
ref table dim_customer
ref table security_mapping
ref table dim_product
ref table cross_sell
ref table fact_forecast
ref table dim_month
ref table _Measures
ref table cohort_retention
ref table holdout_evaluation
ref table forecast_backtest
ref table sku_affinity

ref role 'Sales Rep'
ref role 'BC Region'

ref table pocket_waterfall

ref table pocket_by_customer

ref table leakage_by_component

ref table freight_by_order_band

ref table revenue_bridge

ref table revenue_bridge_by_protein

ref table customer_concentration

ref table pocket_headline

ref table bridge_headline
